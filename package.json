{
  "name": "lexin-material-register",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @lexin/api --filter @lexin/web dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @lexin/db generate",
    "db:migrate": "pnpm --filter @lexin/db migrate",
    "db:seed": "pnpm --filter @lexin/db seed",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
