# Copy to .env (cp .env.example .env). Every app and docker compose read this root file.

# Postgres
POSTGRES_USER=lexin
POSTGRES_PASSWORD=lexin
POSTGRES_DB=material_register
POSTGRES_PORT=5432
DATABASE_URL=postgres://lexin:lexin@localhost:5432/material_register

# API (tRPC server). The web dev server proxies /trpc to this port.
API_PORT=3001
